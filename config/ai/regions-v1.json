    "training_counties": {
      "06111": "Ventura",
      "06083": "Santa Barbara",
      "06059": "Orange",
      "06065": "Riverside",
      "06071": "San Bernardino",
      "06073": "San Diego",
      "06025": "Imperial",
      "06029": "Kern"
